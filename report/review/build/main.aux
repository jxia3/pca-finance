\@writefile{lof}{\contentsline {figure}{\numberline {B.2}{\ignorespaces PCA runtime as stock count, window length, and factor count vary, with other settings fixed as indicated above each panel. Points summarize the median of three window medians, each based on five runs. Shading spans the window medians rather than a confidence interval. Times include standardization and fitting, and the vertical axes are logarithmic. The iterative method's advantage grows with universe size but decreases as more factors are requested.\relax }}{29}{figure.caption.64}\protected@file@percent }
\newlabel{fig:pca-benchmark}{{B.2}{29}{PCA runtime as stock count, window length, and factor count vary, with other settings fixed as indicated above each panel. Points summarize the median of three window medians, each based on five runs. Shading spans the window medians rather than a confidence interval. Times include standardization and fitting, and the vertical axes are logarithmic. The iterative method's advantage grows with universe size but decreases as more factors are requested.\relax }{figure.caption.64}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B.4}Execution and trading costs}{29}{subsection.B.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {B.3}{\ignorespaces Numerical accuracy for 1,201 stocks and 500-day windows. The panels show relative eigenvalue differences, the largest angle between factor subspaces, and relative eigenpair residuals. Subspace angles account for arbitrary eigenvector signs, while residuals check the covariance eigenvalue equation directly. Each point is the worst value across three windows and five fits. Lower is better, and the logarithmic vertical axes have different scales. All checks pass the respective limits of \(10^{-8}\), \(10^{-6}\) radians, and \(10^{-8}\).\relax }}{30}{figure.caption.65}\protected@file@percent }
\newlabel{fig:pca-agreement}{{B.3}{30}{Numerical accuracy for 1,201 stocks and 500-day windows. The panels show relative eigenvalue differences, the largest angle between factor subspaces, and relative eigenpair residuals. Subspace angles account for arbitrary eigenvector signs, while residuals check the covariance eigenvalue equation directly. Each point is the worst value across three windows and five fits. Lower is better, and the logarithmic vertical axes have different scales. All checks pass the respective limits of \(10^{-8}\), \(10^{-6}\) radians, and \(10^{-8}\).\relax }{figure.caption.65}{}}
